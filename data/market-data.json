  "glossary": [
    {
      "term": "Duration",
      "assetClass": "Rates",
      "definition": "A measure of a bond price's sensitivity to changes in interest rates."
    },
    {
      "term": "Curve steepening",
      "assetClass": "Rates",
      "definition": "A move where longer-dated yields rise relative to shorter-dated yields, or shorter-dated yields fall relative to longer-dated yields."
    },
    {
      "term": "Breakeven inflation",
      "assetClass": "Rates",
      "definition": "The market-implied inflation rate derived from nominal Treasury yields and inflation-linked bond yields."
    },
    {
      "term": "Real yield",
      "assetClass": "Rates",
      "definition": "A yield measure adjusted for expected inflation, often watched as a liquidity and valuation signal."
    },
    {
      "term": "Term premium",
      "assetClass": "Rates",
      "definition": "Compensation investors may require for holding longer-maturity bonds instead of rolling short-term debt."
    },
    {
      "term": "Carry",
      "assetClass": "FX",
      "definition": "The expected return from holding a position if spot prices and yield curves are unchanged."
    },
    {
      "term": "Cross-currency basis",
      "assetClass": "FX",
      "definition": "The spread embedded in swapping funding between two currencies, often used as a stress and funding indicator."
    },
    {
      "term": "Credit spread",
      "assetClass": "Credit",
      "definition": "The extra yield a borrower pays over a comparable low-risk benchmark to compensate investors for credit and liquidity risk."
    },
    {
      "term": "CDS",
      "assetClass": "Credit",
      "definition": "A credit default swap, a derivative used to transfer or hedge default risk."
    },
    {
      "term": "MOVE index",
      "assetClass": "Volatility",
      "definition": "A commonly watched index of implied volatility in US Treasury markets."
    },
    {
      "term": "Funding rate",
      "assetClass": "Digital Assets",
      "definition": "A recurring payment between perpetual futures longs and shorts that helps keep futures prices close to spot."
    },
    {
      "term": "Stablecoin",
      "assetClass": "Digital Assets",
      "definition": "A crypto token designed to maintain a stable value against a reference asset such as the US dollar."
    },
    {
      "term": "On-chain flow",
      "assetClass": "Digital Assets",
      "definition": "Observable blockchain transaction activity used as one input in digital asset market analysis."
    },
    {
      "term": "Basis",
      "assetClass": "Derivatives",
      "definition": "The difference between a futures price and the underlying spot price, often used to infer positioning or funding pressure."
    }
  ],
  "methodology": {
    "permanentRule": {
      "title": "Observed Market Data ≠ Reported Driver ≠ Model Interpretation",
      "description": "Do not imply causality from price co-movement alone. Label observed prices, externally reported drivers, and your own interpretation as separate evidence layers.",
      "labels": [
        {
          "name": "Observed Market Data",
          "kind": "primary"
        },
        {
          "name": "Reported Driver",
          "kind": "inference"
        },
        {
          "name": "Model Interpretation",
          "kind": "interpretation"
        }
      ]
    },
    "sourceHierarchy": [
      {
        "rank": 1,
        "name": "Primary official sources",
